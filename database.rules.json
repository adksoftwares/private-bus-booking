{
  "rules": {
    "trips": {
      ".read": true,
      ".indexOn": ["departureDate", "ownerId"],
      "$tripId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || (root.child('owners').child(auth.uid).exists() && (newData.child('ownerId').val() === auth.uid || data.child('ownerId').val() === auth.uid)))"
      }
    },
    "routes": {
      ".read": true,
      ".indexOn": ["ownerId"],
      "$routeId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('owners').child(auth.uid).exists())"
      }
    },
    "buses": {
      ".read": true,
      ".indexOn": ["ownerId"],
      "$busId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || (root.child('owners').child(auth.uid).exists() && (newData.child('ownerId').val() === auth.uid || data.child('ownerId').val() === auth.uid)))"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'Admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'Admin')"
      }
    },
    "owners": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'Admin')"
      }
    },
    "seatLocks": {
      ".read": true,
      "$tripId": {
        "$seatId": {
          ".write": "auth != null || !data.exists()"
        }
      }
    },
    "bookings": {
      "$bookingId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'Admin' || (root.child('users').child(auth.uid).child('role').val() === 'Owner' && data.child('ownerId').val() === auth.uid))",
        ".write": false
      }
    },
    "tickets": {
      "$ticketId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Conductor' || (root.child('users').child(auth.uid).child('role').val() === 'Owner' && data.child('ownerId').val() === auth.uid))",
        ".write": false
      }
    },
    "payments": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('owners').child(auth.uid).exists())",
      ".write": false
    },
    "refunds": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('owners').child(auth.uid).exists())",
      ".write": false
    },
    "busReviews": {
      ".read": true,
      ".write": false
    },
    "indexes": {
      "userBookings": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'Admin')",
          ".write": false
        }
      },
      "bookingReferences": {
        ".read": false,
        ".write": false
      },
      "phoneBookings": {
        ".read": false,
        ".write": false
      }
    }
  }
}
